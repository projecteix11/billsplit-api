SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

REDSYS_SECRET=your-redsys-secret
REDSYS_MERCHANT_CODE=999008881
REDSYS_TERMINAL=001

# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:4173,http://localhost:5173,http://localhost:5174

PORT=3001

# Gemini API (Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEY_FALLBACK=your-gemini-fallback-api-key

# DeepSeek API key
DEEPSEEK_API_KEY=your-deepseek-api-key


# Ollama local completions URL
OLLAMA_URL=http://localhost:11434/v1/chat/completions


# Axiom logging (canonical names read by app/logging/client.py).
# Leave AXIOM_TOKEN empty in local dev to keep events out of Axiom.
AXIOM_TOKEN=
AXIOM_DATASET=gobbly-management
